# 服务器配置模板：cp env.production.example .env，然后填写下面标了「必填」的项

# ---- 镜像 ----
IMAGE=ghcr.io/weizhixiong123/opc-desk:latest
# 宿主机端口，宝塔反向代理到 http://127.0.0.1:这个端口（服务器上 gpt-verify 占了 3010，这里用 3020）
HOST_PORT=3020

# ---- 服务 ----
# 访问地址 https://gptsuchong.com/desk ；和 gpt-verify 的 /sms 同一个站点，各占一个子路径
BASE_PATH=/desk
# 在宝塔 nginx 后面，用 X-Forwarded-For 识别 IP（防暴力猜密码）
TRUST_PROXY=1
# 必填：登录密码，用 openssl rand -base64 18 生成，或自己设一个够长的
LOGIN_PASSWORD=
# 登录后多少天内不用再输密码；改密码会让所有设备重新登录
SESSION_DAYS=30
# 网站开了 https 就保持 1
SECURE_COOKIE=1
